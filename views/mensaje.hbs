<section class="panel panel-mensaje">
  <h2>{{#if titulo}}{{titulo}}{{else}}Aviso{{/if}}</h2>
  <p class="mensaje-texto">{{mensaje}}</p>
  <div class="acciones">
    {{#if volver}}
      <a class="boton" href="{{volver}}">Continuar</a>
    {{else}}
      <a class="boton" href="/">Volver al inicio</a>
    {{/if}}
  </div>
</section>
