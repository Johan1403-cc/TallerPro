<div class="cards"><article><b>{{k.VehiculosTaller}}</b><span>Vehículos en taller</span></article><article><b>{{k.OrdenesPendientes}}</b><span>Órdenes pendientes</span></article><article><b>{{k.OrdenesAtrasadas}}</b><span>Órdenes atrasadas</span></article><article><b>{{k.CitasHoy}}</b><span>Citas de hoy</span></article><article><b>₡{{k.VentasHoy}}</b><span>Ventas del día</span></article><article><b>₡{{k.IngresosMes}}</b><span>Ingresos del mes</span></article><article><b>{{k.ProductosMinimos}}</b><span>Stock mínimo</span></article><article><b>{{k.FacturasPendientes}}</b><span>Facturas pendientes</span></article></div><div class="panel"><h2>Ventas recientes</h2><div class="chart" id="chart">{{#each chart}}<div class="bar-wrap"><div class="bar" data-v="{{Total}}"></div><small>{{Mes}}<br>₡{{Total}}</small></div>{{/each}}</div></div><script>addEventListener('DOMContentLoaded',()=>{let bars=[...document.querySelectorAll('.bar')],m=Math.max(...bars.map(x=>+x.dataset.v),1);bars.forEach(x=>x.style.height=(20+(+x.dataset.v/m)*160)+'px')})</script>
