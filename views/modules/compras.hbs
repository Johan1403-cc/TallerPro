<div class="panel">
  <h2>Registrar compra</h2>
  <form id="compraForm">
    <div class="form-grid">
      <label>Proveedor
        <select name="ProveedorId" id="proveedorSelect" required>
          <option value="">Seleccione un proveedor...</option>
        </select>
      </label>
      <label>Factura proveedor
        <input name="NumeroFacturaProveedor" required>
      </label>
      <label>Forma de pago
        <select name="FormaPago">
          <option value="CONTADO">Contado</option>
          <option value="CREDITO">Crédito</option>
          <option value="PARCIAL">Parcialmente pagada</option>
        </select>
      </label>
    </div>

    <h3>Detalle</h3>
    <p class="muted">Los productos disponibles dependen del proveedor seleccionado. El costo unitario e impuesto se cargan desde el producto.</p>
    <div id="items"></div>
    <button type="button" id="addBtn">+ Agregar producto</button>
    <div class="dialog-actions"><button class="primary">Confirmar compra</button></div>
  </form>
  <div id="msg" class="message"></div>
</div>

<div class="panel"><h2>Compras registradas</h2><div class="table-wrap"><table id="qtable"></table></div></div>
<script src="/javascripts/querytable.js"></script>
<script>
let productosProveedor=[];
const money=n=>Number(n||0).toLocaleString('es-CR',{minimumFractionDigits:2,maximumFractionDigits:2});

async function cargarFormulario(){
  const j=await api('/api/query/compras-form');
  proveedorSelect.innerHTML='<option value="">Seleccione un proveedor...</option>'+(j.proveedores||[]).map(p=>`<option value="${p.ProveedorId}">${p.NombreRazonSocial}</option>`).join('');
}

async function cargarProductosProveedor(){
  productosProveedor=[];
  items.innerHTML='';
  const id=proveedorSelect.value;
  addBtn.disabled=!id;
  if(!id)return;
  const j=await api('/api/query/compras-productos/'+id);
  productosProveedor=j.productos||[];
  addItem();
}

function opcionesProductos(selected=''){
  return '<option value="">Seleccione un producto...</option>'+productosProveedor.map(p=>`<option value="${p.ProductoId}" ${String(p.ProductoId)===String(selected)?'selected':''}>${p.CodigoInterno} — ${p.Nombre}</option>`).join('');
}

function addItem(){
  if(!proveedorSelect.value){alert('Primero seleccione un proveedor.');return;}
  if(!productosProveedor.length){alert('El proveedor seleccionado no tiene productos asociados activos.');return;}
  const div=document.createElement('div');
  div.className='line compra-line';
  div.innerHTML=`
    <label style="flex:2">Producto<select class="pid" required>${opcionesProductos()}</select></label>
    <label>Cantidad<input type="number" min="0.01" step="0.01" class="qty" required></label>
    <label>Costo unitario<input type="number" step="0.01" class="price" readonly required></label>
    <label>Impuesto %<input type="number" step="0.01" class="tax" readonly></label>
    <label>Descuento<input type="number" min="0" step="0.01" class="disc" value="0"></label>
    <button type="button" class="remove-item">×</button>`;
  const sel=div.querySelector('.pid');
  sel.onchange=()=>{
    const p=productosProveedor.find(x=>String(x.ProductoId)===sel.value);
    div.querySelector('.price').value=p?Number(p.PrecioCompra).toFixed(2):'';
    div.querySelector('.tax').value=p?Number(p.PorcentajeImpuesto).toFixed(2):'';
  };
  div.querySelector('.remove-item').onclick=()=>div.remove();
  items.appendChild(div);
}

proveedorSelect.onchange=cargarProductosProveedor;
addBtn.onclick=addItem;

compraForm.onsubmit=async e=>{
  e.preventDefault();
  const lines=[...document.querySelectorAll('.compra-line')];
  if(!lines.length){alert('Debe agregar al menos un producto.');return;}
  const b=Object.fromEntries(new FormData(e.target));
  b.ProveedorId=+b.ProveedorId;
  b.detalles=lines.map(x=>({
    ProductoId:+x.querySelector('.pid').value,
    Cantidad:+x.querySelector('.qty').value,
    CostoUnitario:+x.querySelector('.price').value,
    ImpuestoPorcentaje:+x.querySelector('.tax').value,
    Descuento:+x.querySelector('.disc').value
  }));
  const j=await api('/api/ops/compras/confirmar',{method:'POST',body:JSON.stringify(b)});
  msg.textContent=j.message||JSON.stringify(j.data||j);
  if(j.ok){compraForm.reset();items.innerHTML='';productosProveedor=[];addBtn.disabled=true;}
  await loadQ('compras');
};

addEventListener('DOMContentLoaded',async()=>{await cargarFormulario();addBtn.disabled=true;await loadQ('compras');});
</script>
