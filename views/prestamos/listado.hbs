<section class="panel">
  <div class="panel-header">
    <h2>Listado de prestamos</h2>
    <a class="boton boton-chico" href="/prestamos/alta">+ Solicitar prestamo</a>
  </div>

  {{#if prestamos.length}}
  <table class="tabla">
    <thead>
      <tr><th>Numero</th><th>Cliente</th><th>Monto</th><th>Plazo</th><th>Cuota mensual</th><th>Fecha</th><th></th></tr>
    </thead>
    <tbody>
      {{#each prestamos}}
      <tr>
        <td>{{this.numero_prestamo}}</td>
        <td>{{this.nombre}} {{this.apellidos}}</td>
        <td>{{this.monto}}</td>
        <td>{{this.plazo_meses}} meses</td>
        <td>{{this.cuota_mensual}}</td>
        <td>{{this.fecha_solicitud}}</td>
        <td><a class="enlace-accion" href="/prestamos/detalle/{{this.id}}">Ver cuotas</a></td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
    <p class="vacio">No hay prestamos registrados.</p>
  {{/if}}
</section>
