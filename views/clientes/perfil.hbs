<section class="panel perfil-cabecera">
  <div class="perfil-avatar">{{cliente.nombre.[0]}}{{cliente.apellidos.[0]}}</div>
  <div class="perfil-datos">
    <h2>{{cliente.nombre}} {{cliente.apellidos}}</h2>
    <p>Cedula: <strong>{{cliente.cedula}}</strong></p>
    <p>Telefono: {{cliente.telefono}} &nbsp;|&nbsp; Correo: {{cliente.email}}</p>
    <p>Direccion: {{cliente.direccion}}</p>
    <p class="perfil-desde">Cliente desde: {{cliente.fecha_registro}}</p>
  </div>
  <div class="perfil-acciones">
    <a class="boton boton-chico" href="/clientes/modificar/{{cliente.id}}">Editar datos</a>
    <a class="enlace-accion enlace-peligro" href="/clientes/eliminar/{{cliente.id}}" onclick="return confirm('¿Seguro que desea eliminar este cliente?')">Eliminar cliente</a>
  </div>
</section>

<section class="panel">
  <div class="panel-header">
    <h2>Cuentas bancarias</h2>
    <a class="boton boton-chico" href="/cuentas/alta">+ Abrir cuenta</a>
  </div>

  <div class="selector-moneda">
    <a class="pestana {{#if (eq monedaSeleccionada "CRC")}}pestana-activa{{/if}}" href="/clientes/perfil/{{cliente.id}}?moneda=CRC">Colones (CRC)</a>
    <a class="pestana {{#if (eq monedaSeleccionada "USD")}}pestana-activa{{/if}}" href="/clientes/perfil/{{cliente.id}}?moneda=USD">Dolares (USD)</a>
  </div>

  {{#if cuentaActiva}}
    <div class="tarjeta-cuenta">
      <div class="tarjeta-cuenta-fila">
        <span class="etiqueta">IBAN</span>
        <span class="valor">{{cuentaActiva.iban}}</span>
      </div>
      <div class="tarjeta-cuenta-fila">
        <span class="etiqueta">Alias</span>
        <span class="valor">{{cuentaActiva.alias}}</span>
      </div>
      <div class="tarjeta-cuenta-fila">
        <span class="etiqueta">Saldo disponible</span>
        <span class="valor saldo">{{cuentaActiva.saldo}} {{cuentaActiva.moneda}}</span>
      </div>
      <div class="tarjeta-cuenta-fila">
        <span class="etiqueta">Apertura</span>
        <span class="valor">{{cuentaActiva.fecha_apertura}}</span>
      </div>
    </div>

    <div class="acciones acciones-cuenta">
      <a class="boton" href="/movimientos/deposito">Depositar</a>
      <a class="boton boton-secundario" href="/movimientos/retiro">Retirar</a>
    </div>

    <h3 class="subtitulo">Movimientos de esta cuenta</h3>
    {{#if movimientos.length}}
    <table class="tabla">
      <thead>
        <tr>
          <th>Tipo</th>
          <th>Monto</th>
          <th>Descripcion</th>
          <th>Saldo anterior</th>
          <th>Saldo nuevo</th>
          <th>Fecha</th>
        </tr>
      </thead>
      <tbody>
        {{#each movimientos}}
        <tr>
          <td><span class="etiqueta-tipo etiqueta-{{this.tipo}}">{{this.tipo}}</span></td>
          <td>{{this.monto}} {{this.moneda}}</td>
          <td>{{this.descripcion}}</td>
          <td>{{this.saldo_anterior}}</td>
          <td>{{this.saldo_nuevo}}</td>
          <td>{{this.fecha}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
      <p class="vacio">Esta cuenta todavia no tiene movimientos.</p>
    {{/if}}
  {{else}}
    <p class="vacio">El cliente no tiene una cuenta en esta moneda. Puede abrir una con el boton de arriba.</p>
  {{/if}}
</section>

<section class="panel">
  <div class="panel-header">
    <h2>Prestamos</h2>
    <a class="boton boton-chico" href="/prestamos/alta">+ Solicitar prestamo</a>
  </div>
  {{#if prestamos.length}}
  <table class="tabla">
    <thead>
      <tr><th>Numero</th><th>Monto</th><th>Plazo</th><th>Cuota mensual</th><th>Fecha</th><th></th></tr>
    </thead>
    <tbody>
      {{#each prestamos}}
      <tr>
        <td>{{this.numero_prestamo}}</td>
        <td>{{this.monto}}</td>
        <td>{{this.plazo_meses}} meses</td>
        <td>{{this.cuota_mensual}}</td>
        <td>{{this.fecha_solicitud}}</td>
        <td><a class="enlace-accion" href="/prestamos/detalle/{{this.id}}">Ver cuotas</a></td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
    <p class="vacio">El cliente no tiene prestamos activos.</p>
  {{/if}}
</section>

<section class="panel">
  <div class="panel-header">
    <h2>Certificados de deposito a plazo</h2>
    <a class="boton boton-chico" href="/certificados/alta">+ Solicitar certificado</a>
  </div>
  {{#if certificados.length}}
  <table class="tabla">
    <thead>
      <tr><th>Numero</th><th>Monto</th><th>Plazo</th><th>Tasa anual</th><th>Monto al vencer</th><th>Vence</th></tr>
    </thead>
    <tbody>
      {{#each certificados}}
      <tr>
        <td>{{this.numero_certificado}}</td>
        <td>{{this.monto}}</td>
        <td>{{this.plazo_meses}} meses</td>
        <td>{{this.tasa_interes}}%</td>
        <td>{{this.monto_vencimiento}}</td>
        <td>{{this.fecha_vencimiento}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
    <p class="vacio">El cliente no tiene certificados de deposito.</p>
  {{/if}}
</section>

<section class="panel">
  <div class="panel-header">
    <h2>Tarjetas de credito</h2>
    <a class="boton boton-chico" href="/tarjetas/alta">+ Solicitar tarjeta</a>
  </div>
  {{#if tarjetas.length}}
  <table class="tabla">
    <thead>
      <tr><th>Numero</th><th>Limite de credito</th><th>Emision</th></tr>
    </thead>
    <tbody>
      {{#each tarjetas}}
      <tr>
        <td>**** **** **** {{this.ultimos4}}</td>
        <td>{{this.limite_credito}}</td>
        <td>{{this.fecha_emision}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
    <p class="vacio">El cliente no tiene tarjetas de credito.</p>
  {{/if}}
</section>
