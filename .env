DB_AUTH_MODE=sql
DB_SERVER=your-server.database.windows.net
DB_PORT=1433
DB_NAME=taller_mecanico
DB_USER=your-user
DB_PASSWORD=your-password
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

APP_SESSION_SECRET=replace-with-a-long-random-secret
NODE_ENV=production

# El bloqueo de login se configura en CONFIGURACION_GENERAL (Azure SQL):
# LOGIN_MAX_ATTEMPTS=3 y LOGIN_LOCK_MINUTES=15
