<section class="panel">
  <div class="panel-header">
    <h2>Listado de clientes</h2>
    <a class="boton boton-chico" href="/clientes/alta">+ Nuevo cliente</a>
  </div>

  {{#if clientes.length}}
  <table class="tabla">
    <thead>
      <tr>
        <th>Cedula</th>
        <th>Nombre completo</th>
        <th>Telefono</th>
        <th>Correo</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      {{#each clientes}}
      <tr>
        <td>{{this.cedula}}</td>
        <td><a href="/clientes/perfil/{{this.id}}">{{this.nombre}} {{this.apellidos}}</a></td>
        <td>{{this.telefono}}</td>
        <td>{{this.email}}</td>
        <td class="celda-acciones">
          <a class="enlace-accion" href="/clientes/perfil/{{this.id}}">Ver</a>
          <a class="enlace-accion" href="/clientes/modificar/{{this.id}}">Editar</a>
          <a class="enlace-accion enlace-peligro" href="/clientes/eliminar/{{this.id}}" onclick="return confirm('¿Seguro que desea eliminar este cliente?')">Eliminar</a>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
    <p class="vacio">No hay clientes registrados todavia.</p>
  {{/if}}
</section>
