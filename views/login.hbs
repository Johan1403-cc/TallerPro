<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Iniciar sesión | TallerPro</title><link rel="stylesheet" href="/stylesheets/style.css"></head><body class="login-page"><form id="loginForm" class="login-card"><div class="logo">🔧</div><h1>TallerPro</h1><p>Administración integral del taller mecánico</p><label>Usuario o correo<input name="identifier" autocomplete="username" required placeholder="admin o admin@tallerpro.cr"></label><label>Contraseña<input name="password" type="password" autocomplete="current-password" required></label><button class="primary" type="submit">Iniciar sesión</button><div id="msg" class="message"></div></form><script>document.getElementById('loginForm').addEventListener('submit',async e=>{e.preventDefault();const o=Object.fromEntries(new FormData(e.target));const r=await fetch('/api/auth/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(o)});const j=await r.json();if(j.ok)location='/dashboard';else document.getElementById('msg').textContent=j.message;});</script></body></html>
