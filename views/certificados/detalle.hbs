<section class="panel">
  <h2>Certificado {{certificado.numero_certificado}}</h2>
  <p>Cliente: <strong>{{certificado.nombre}} {{certificado.apellidos}}</strong></p>

  <div class="tarjeta-cuenta">
    <div class="tarjeta-cuenta-fila">
      <span class="etiqueta">Monto invertido</span>
      <span class="valor">{{certificado.monto}}</span>
    </div>
    <div class="tarjeta-cuenta-fila">
      <span class="etiqueta">Plazo</span>
      <span class="valor">{{certificado.plazo_meses}} meses</span>
    </div>
    <div class="tarjeta-cuenta-fila">
      <span class="etiqueta">Tasa de interes anual</span>
      <span class="valor">{{certificado.tasa_interes}}%</span>
    </div>
    <div class="tarjeta-cuenta-fila">
      <span class="etiqueta">Monto al vencimiento</span>
      <span class="valor saldo">{{certificado.monto_vencimiento}}</span>
    </div>
    <div class="tarjeta-cuenta-fila">
      <span class="etiqueta">Fecha de apertura</span>
      <span class="valor">{{certificado.fecha_apertura}}</span>
    </div>
    <div class="tarjeta-cuenta-fila">
      <span class="etiqueta">Fecha de vencimiento</span>
      <span class="valor">{{certificado.fecha_vencimiento}}</span>
    </div>
  </div>

  <div class="acciones">
    <a class="boton" href="/clientes/perfil/{{certificado.cliente_id}}">Volver al perfil del cliente</a>
  </div>
</section>
