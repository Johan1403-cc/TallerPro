<section class="panel panel-formulario">
  <h2>Realizar deposito</h2>
  <form method="POST" action="/movimientos/deposito">
    <div class="campo campo-ancho">
      <label>Cuenta destino</label>
      <select name="cuenta_id" required>
        <option value="">-- Seleccione una cuenta --</option>
        {{#each cuentas}}
          <option value="{{this.id}}">{{this.iban}} - {{this.nombre}} {{this.apellidos}} ({{this.moneda}}) - Saldo actual: {{this.saldo}}</option>
        {{/each}}
      </select>
    </div>
    <div class="campo">
      <label>Monto</label>
      <input type="number" name="monto" step="0.01" min="0.01" required />
    </div>
    <div class="campo">
      <label>Fecha</label>
      <input type="date" name="fecha" required />
    </div>
    <div class="campo campo-ancho">
      <label>Descripcion</label>
      <input type="text" name="descripcion" maxlength="200" required placeholder="Ej: Deposito en ventanilla" />
    </div>
    <div class="acciones">
      <button type="submit" class="boton">Confirmar deposito</button>
    </div>
  </form>
</section>
