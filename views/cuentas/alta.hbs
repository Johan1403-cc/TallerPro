<section class="panel panel-formulario">
  <h2>Abrir cuenta bancaria</h2>
  <form method="POST" action="/cuentas/alta">
    <div class="campo campo-ancho">
      <label>Cliente</label>
      <select name="cliente_id" required>
        <option value="">-- Seleccione un cliente --</option>
        {{#each clientes}}
          <option value="{{this.id}}">{{this.nombre}} {{this.apellidos}} ({{this.cedula}})</option>
        {{/each}}
      </select>
    </div>
    <div class="campo">
      <label>Moneda</label>
      <select name="moneda" required>
        <option value="CRC">Colones (CRC)</option>
        <option value="USD">Dolares (USD)</option>
      </select>
    </div>
    <div class="campo">
      <label>Alias de la cuenta (opcional)</label>
      <input type="text" name="alias" maxlength="50" placeholder="Ej: Cuenta de ahorros" />
    </div>
    <p class="nota">La cuenta se abrira con saldo inicial de 0 y se le asignara automaticamente un numero IBAN.</p>
    <div class="acciones">
      <button type="submit" class="boton">Abrir cuenta</button>
    </div>
  </form>
</section>
