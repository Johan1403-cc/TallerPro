<section class="panel panel-formulario">
  <h2>Modificar cliente</h2>
  <form method="POST" action="/clientes/modificar">
    <input type="hidden" name="id" value="{{cliente.id}}" />
    <div class="campo">
      <label>Cedula</label>
      <input type="text" name="cedula" required maxlength="20" value="{{cliente.cedula}}" />
    </div>
    <div class="campo">
      <label>Nombre</label>
      <input type="text" name="nombre" required maxlength="60" value="{{cliente.nombre}}" />
    </div>
    <div class="campo">
      <label>Apellidos</label>
      <input type="text" name="apellidos" required maxlength="60" value="{{cliente.apellidos}}" />
    </div>
    <div class="campo">
      <label>Telefono</label>
      <input type="text" name="telefono" maxlength="20" value="{{cliente.telefono}}" />
    </div>
    <div class="campo">
      <label>Correo electronico</label>
      <input type="email" name="email" maxlength="80" value="{{cliente.email}}" />
    </div>
    <div class="campo campo-ancho">
      <label>Direccion</label>
      <input type="text" name="direccion" maxlength="150" value="{{cliente.direccion}}" />
    </div>
    <div class="acciones">
      <button type="submit" class="boton">Guardar cambios</button>
    </div>
  </form>
</section>
