<section class="panel panel-formulario">
  <h2>Solicitar certificado de deposito a plazo</h2>
  <p class="nota">Un certificado de deposito a plazo (CDP) es un producto en el que el cliente invierte un monto por un plazo fijo y recibe ese monto mas los intereses generados al vencimiento. A mayor plazo, mejor tasa de interes.</p>
  <form method="POST" action="/certificados/alta">
    <div class="campo campo-ancho">
      <label>Cliente</label>
      <select name="cliente_id" required>
        <option value="">-- Seleccione un cliente --</option>
        {{#each clientes}}
          <option value="{{this.id}}">{{this.nombre}} {{this.apellidos}} ({{this.cedula}})</option>
        {{/each}}
      </select>
    </div>
    <div class="campo">
      <label>Monto a invertir</label>
      <input type="number" name="monto" step="0.01" min="0.01" required />
    </div>
    <div class="campo">
      <label>Plazo</label>
      <select name="plazo_meses" required>
        <option value="3">3 meses (tasa 2.0% anual)</option>
        <option value="6">6 meses (tasa 3.5% anual)</option>
        <option value="12">12 meses (tasa 5.0% anual)</option>
      </select>
    </div>
    <div class="acciones">
      <button type="submit" class="boton">Solicitar certificado</button>
    </div>
  </form>
</section>
