<section class="panel panel-formulario">
  <h2>Solicitar tarjeta de credito</h2>
  <form method="POST" action="/tarjetas/alta">
    <div class="campo campo-ancho">
      <label>Cliente</label>
      <select name="cliente_id" required>
        <option value="">-- Seleccione un cliente --</option>
        {{#each clientes}}
          <option value="{{this.id}}">{{this.nombre}} {{this.apellidos}} ({{this.cedula}})</option>
        {{/each}}
      </select>
    </div>
    <div class="campo">
      <label>Limite de credito</label>
      <input type="number" name="limite_credito" step="0.01" min="0.01" required />
    </div>
    <div class="acciones">
      <button type="submit" class="boton">Emitir tarjeta</button>
    </div>
  </form>
</section>
